{
  "name": "german-flashcards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:vocab && vite",
    "build": "npm run build:vocab && tsc --noEmit && vite build",
    "build:vocab": "tsx scripts/build-vocab.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:vocab": "tsx scripts/validate-vocab.ts",
    "check": "tsc --noEmit && vitest run && npm run validate:vocab"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
